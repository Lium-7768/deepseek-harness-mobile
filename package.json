{
  "name": "deepseek-harness-mobile",
  "version": "0.1.0",
  "description": "Independent Expo and React Native client for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "./scripts/android-env.sh expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:assemble": "./scripts/android-env.sh bash -c \"cd android && ./gradlew :app:assembleDebug --no-daemon\"",
    "android:bundle": "./scripts/android-env.sh bash -c \"cd android && ./gradlew :app:bundleRelease --no-daemon\"",
    "release:verify": "node scripts/release-verify.mjs",
    "release:android": "node scripts/release-verify.mjs \"$RELEASE_TAG\" && ./scripts/android-env.sh bash -c \"cd android && ./gradlew :app:bundleRelease --no-daemon\"",
    "release:ios": "node scripts/release-verify.mjs \"$RELEASE_TAG\" && ./scripts/ios-release-archive.sh",
    "release:eas": "node scripts/release-verify.mjs \"$RELEASE_TAG\" && pnpm dlx eas-cli@22.2.0 build --platform all --profile production",
    "format": "prettier --write app src tests scripts/visual docs/IMPROVEMENT-PLAN.md",
    "format:check": "prettier --check app src tests scripts/visual docs/IMPROVEMENT-PLAN.md"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.31",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.22",
    "expo-file-system": "~57.0.7",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.22",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-navigation-bar": "~57.0.3",
    "expo-notifications": "~57.0.25",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "highlight.js": "^11.12.0",
    "lowlight": "^3.3.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/generator": "7.29.8",
    "@react-native/metro-config": "0.86.3",
    "@testing-library/react-native": "14.1.0",
    "@types/react": "^19.2.0",
    "prettier": "^3.6.2",
    "test-renderer": "1.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": "10.26.2"
  }
}
