{
  "name": "deepseek-harness-mobile",
  "version": "0.1.0",
  "description": "Independent Expo and React Native client for DeepSeek Harness.",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "./scripts/android-env.sh expo run:android",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "android:assemble": "./scripts/android-env.sh bash -c \"cd android && ./gradlew :app:assembleDebug --no-daemon\"",
    "android:bundle": "./scripts/android-env.sh bash -c \"cd android && ./gradlew :app:bundleRelease --no-daemon\""
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.13",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "57.0.1",
    "expo-constants": "~57.0.11",
    "expo-file-system": "~57.0.4",
    "expo-image-picker": "~57.0.11",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.0",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.13",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "~4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/generator": "7.29.8",
    "@types/react": "^19.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=22.23.2 <23",
    "pnpm": "10.26.2"
  }
}
