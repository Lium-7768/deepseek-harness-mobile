{
  "expo": {
    "name": "DeepSeek Harness",
    "slug": "deepseek-harness",
    "scheme": "dsh",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.deepseek.harness",
      "entitlements": {
        "keychain-access-groups": [
          "$(AppIdentifierPrefix)$(CFBundleIdentifier)"
        ]
      }
    },
    "android": {
      "package": "ai.deepseek.harness",
      "adaptiveIcon": {
        "foregroundImage": "./assets/whale-mark.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许 DeepSeek Harness 访问照片，以便将图片作为消息附件发送给当前会话。"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "允许 DeepSeek Harness 使用相机扫描桌面端配对二维码或拍照作为会话附件。"
        }
      ],
      "expo-sharing",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "dark": {
            "backgroundColor": "#161618"
          },
          "image": "./assets/splash-whale.png",
          "imageWidth": 108,
          "resizeMode": "contain"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "icon": "./assets/whale-mark.png",
    "splash": {
      "image": "./assets/whale-mark.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "androidStatusBar": {
      "backgroundColor": "#FFFFFF",
      "barStyle": "dark-content",
      "translucent": true
    },
    "platforms": [
      "ios",
      "android"
    ]
  }
}
