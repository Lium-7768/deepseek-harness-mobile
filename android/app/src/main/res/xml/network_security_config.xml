<?xml version="1.0" encoding="utf-8"?>
<!-- A user-selected gateway may use an arbitrary LAN IP, local hostname,
     loopback or emulator-host HTTP origin. Android domain-config cannot express
     private CIDR ranges, so this app-wide exception deliberately permits HTTP.
     HTTPS gateways use only the system CA store; user-installed CAs are not
     trusted by release builds. -->
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system"/>
    </trust-anchors>
  </base-config>
</network-security-config>
